# ─── Required ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (get from Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chatapp?retryWrites=true&w=majority

# ─── Optional (have sensible defaults) ───────────────────────────────────────
# Port the server listens on (Render injects this automatically)
PORT=5000

# Comma-separated list of allowed frontend origins
# For multiple (e.g. preview + production): https://app.vercel.app,https://preview.vercel.app
CLIENT_URL=http://localhost:5173

# Set to 'production' on Render
NODE_ENV=development
